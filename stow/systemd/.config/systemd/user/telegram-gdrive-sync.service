[Unit]
Description=Telegram to Google Drive Auto-Sync Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/skc/Documents/antigravity/radiant-borg
ExecStart=/home/skc/.local/bin/uv run python main.py
Restart=on-failure
RestartSec=30s
StandardOutput=append:/home/skc/Documents/antigravity/radiant-borg/logs/daemon.log
StandardError=append:/home/skc/Documents/antigravity/radiant-borg/logs/daemon.log

[Install]
WantedBy=default.target
