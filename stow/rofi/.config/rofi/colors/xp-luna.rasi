/* Windows XP Royale Dark Rofi Theme */
* {
    font: "Inter 12";
    bg-main:     #111726;
    bg-header:   #1A2238;
    bg-card:     #172033;
    bg-selected: #264C84;
    fg-primary:  #FFFFFF;
    fg-muted:    #A9B8D4;
    accent:      #FF8C00;
    border-col:  #2A3654;

    background-color: transparent;
    text-color:       @fg-primary;
    margin:           0px;
    padding:          0px;
}

window {
    background-color: @bg-main;
    border:           2px;
    border-color:     @border-col;
    border-radius:    6px;
    width:            650px;
    padding:          16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  14px;
}

inputbar {
    background-color: @bg-header;
    border:           1px;
    border-color:     @border-col;
    border-radius:    4px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:  @accent;
    font:        "Inter Bold 12";
    margin:      0px 10px 0px 0px;
}

entry {
    placeholder:       "Search applications...";
    placeholder-color: @fg-muted;
    text-color:        @fg-primary;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      6px;
    scrollbar:    false;
}

element {
    padding:       8px 12px;
    border-radius: 4px;
    background-color: @bg-card;
}

element normal.normal {
    background-color: @bg-card;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       #FFFFFF;
    border:           1px;
    border-color:     @accent;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
