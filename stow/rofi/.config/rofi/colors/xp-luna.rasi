/* Steam UI Dark Slate Rofi Theme */
* {
    font: "Inter 12";
    bg-main:     #0D1117;
    bg-header:   #161B22;
    bg-card:     #161B22;
    bg-selected: #21262D;
    fg-primary:  #F0F6FC;
    fg-muted:    #8B949E;
    accent:      #58A6FF;
    border-col:  #30363D;

    background-color: transparent;
    text-color:       @fg-primary;
    margin:           0px;
    padding:          0px;
}

window {
    background-color: @bg-main;
    border:           1px;
    border-color:     @border-col;
    border-radius:    8px;
    width:            620px;
    padding:          14px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  12px;
}

inputbar {
    background-color: @bg-header;
    border:           1px;
    border-color:     @border-col;
    border-radius:    6px;
    padding:          8px 12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:  @accent;
    font:        "Inter SemiBold 12";
    margin:      0px 8px 0px 0px;
}

entry {
    placeholder:       "Search applications...";
    placeholder-color: @fg-muted;
    text-color:        @fg-primary;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      4px;
    scrollbar:    false;
}

element {
    padding:       8px 12px;
    border-radius: 6px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       #FFFFFF;
    border:           1px;
    border-color:     @accent;
}

element-icon {
    size: 22px;
    margin: 0px 10px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
