/* Windows 7 Aero Glass Rofi Theme */
* {
    font: "Segoe UI, Inter 12";
    bg-main:     rgba(15, 23, 42, 0.85);
    bg-header:   rgba(30, 58, 138, 0.9);
    bg-card:     rgba(30, 41, 59, 0.7);
    bg-selected: rgba(59, 130, 246, 0.6);
    fg-primary:  #FFFFFF;
    fg-muted:    #CBD5E1;
    accent:      #60A5FA;
    border-col:  rgba(147, 197, 253, 0.4);

    background-color: transparent;
    text-color:       @fg-primary;
    margin:           0px;
    padding:          0px;
}

window {
    background-color: @bg-main;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    width:            650px;
    padding:          16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  14px;
}

inputbar {
    background-color: @bg-header;
    border:           1px;
    border-color:     @border-col;
    border-radius:    6px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:  @accent;
    font:        "Segoe UI Bold, Inter Bold 12";
    margin:      0px 10px 0px 0px;
}

entry {
    placeholder:       "Search programs and files...";
    placeholder-color: @fg-muted;
    text-color:        @fg-primary;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      6px;
    scrollbar:    false;
}

element {
    padding:       8px 12px;
    border-radius: 6px;
    background-color: @bg-card;
}

element normal.normal {
    background-color: @bg-card;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       #FFFFFF;
    border:           1px;
    border-color:     @accent;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
